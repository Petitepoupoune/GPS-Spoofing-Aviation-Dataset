message: "If you use this dataset, please cite it as below."
type: dataset
title: "GPS Spoofing Synthetic Dataset for Commercial Aviation"
authors:
  - family-names: Sutre
    given-names: Nina
    affiliation: Polytechnique Montréal
    email: nina.sutre@etud.polymtl.ca
